LATTICE_AUTH_MODE=development
# Development only. Replace with at least 32 random characters.
LATTICE_DEV_API_KEY=replace-this-development-key-00000001
LATTICE_BIND_ADDRESS=0.0.0.0:8000
LATTICE_ALLOWED_ORIGIN=http://localhost:8080
LATTICE_COMMAND_TTL_SECONDS=30
LATTICE_HEARTBEAT_TIMEOUT_SECONDS=10
LATTICE_CORE_URL=http://localhost:8000
LATTICE_BODY_ID=rover-r1
LATTICE_BODY_NAME=Rover R1
RUST_LOG=info,lattice=debug

# Optional platform services
POSTGRES_PASSWORD=replace-this-postgres-password

# Optional persistent local core; run-durable-warehouse.sh provisions these for you.
# LATTICE_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:55433/lattice
# LATTICE_SIGNING_KEY_FILE=/absolute/private/path/signing.key
