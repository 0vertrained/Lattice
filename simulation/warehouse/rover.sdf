<?xml version="1.0"?>
<sdf version="1.9"><model name="lattice_rover"><pose>0 0 0.09 0 0 0</pose>
<link name="base_link">
  <inertial><pose>-0.04 0 0.08 0 0 0</pose><mass>5</mass><inertia><ixx>0.04</ixx><iyy>0.06</iyy><izz>0.08</izz></inertia></inertial>
  <collision name="chassis"><pose>0 0 0.08 0 0 0</pose><geometry><box><size>0.4 0.25 0.12</size></box></geometry></collision>
  <visual name="chassis_visual"><pose>0 0 0.08 0 0 0</pose><geometry><box><size>0.4 0.25 0.12</size></box></geometry><material><diffuse>0.1 0.6 0.9 1</diffuse></material></visual>
  <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.22 0 0 0</pose><topic>scan</topic><gz_frame_id>laser</gz_frame_id><update_rate>10</update_rate><lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan><range><min>0.08</min><max>12</max><resolution>0.01</resolution></range></lidar><always_on>true</always_on></sensor>
  <sensor name="inspection_camera" type="camera"><pose>0.18 0 0.26 0 0 0</pose><topic>camera/image</topic><gz_frame_id>camera</gz_frame_id><update_rate>5</update_rate><camera><horizontal_fov>1.0472</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.05</near><far>15</far></clip></camera><always_on>true</always_on></sensor>
</link>
<link name="left_wheel"><pose>0 0.16 0 1.57079632679 0 0</pose><inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial><collision name="wheel"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry></collision><visual name="wheel_visual"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry></visual></link>
<link name="right_wheel"><pose>0 -0.16 0 1.57079632679 0 0</pose><inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial><collision name="wheel"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry></collision><visual name="wheel_visual"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry></visual></link>
<link name="caster"><pose>-0.15 0 -0.04 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial><collision name="ball"><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision></link>
<joint name="left_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
<joint name="right_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
<joint name="caster_joint" type="fixed"><parent>base_link</parent><child>caster</child></joint>
<plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_joint</left_joint><right_joint>right_joint</right_joint><wheel_separation>0.32</wheel_separation><wheel_radius>0.08</wheel_radius><topic>motor_cmd_vel</topic><odom_topic>odom</odom_topic><tf_topic>tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>30</odom_publish_frequency><max_linear_acceleration>0.5</max_linear_acceleration><max_linear_velocity>0.4</max_linear_velocity><max_angular_velocity>0.8</max_angular_velocity></plugin>
<plugin filename="liblattice-sim-watchdog.so" name="lattice::SimWatchdog"/>
</model></sdf>
