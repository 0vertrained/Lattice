ARG RUST_VERSION=1.97.1
FROM rust:${RUST_VERSION}-bookworm AS build
ARG PACKAGE
WORKDIR /workspace
COPY . .
RUN cargo build --locked --release --package "${PACKAGE}"

FROM debian:bookworm-slim
ARG PACKAGE
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 lattice
COPY --from=build /workspace/target/release/${PACKAGE} /usr/local/bin/service
COPY --from=build --chmod=0444 /workspace/simulation/routes/*.json /app/routes/
USER lattice
ENTRYPOINT ["/usr/local/bin/service"]
